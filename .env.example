# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is committed as documentation.
#
# For local SQLite dev (the default):
DATABASE_URL="file:./dev.db"

# For docker-compose local-prod (the web service overrides this with the
# Postgres service URL — you don't need to set it here unless you're
# pointing the local Node process at Postgres).
# DATABASE_URL="postgresql://prediq:prediq_dev@localhost:5432/prediq?schema=public"

# Demo seed password — used to log in as Alice/Bob/admin etc out of the box.
# Must be ≥ 8 chars (server enforces).
DEMO_PASSWORD="demo1234"

# Mistral API key (https://console.mistral.ai). Without this the news
# pipeline's draft generator throws on first call. Leave unset to disable.
MISTRAL_API_KEY=""

# Cron cadence for the news ingest pipeline, in minutes. Recommended: 360
# (every 6 hours). Unset / 0 disables. Each run hits ~25 Mistral requests.
# NEWS_INGEST_INTERVAL_MIN=360
