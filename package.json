{
  "name": "prediq",
  "version": "0.2.0",
  "private": true,
  "description": "predIQ — an LMSR-based prediction market with PAS skill rating, calibration analytics, and a play-chip economy.",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:cluster": "node server/cluster.js",
    "dev": "node --watch server/index.js",
    "test": "jest",
    "test:ci": "jest --ci --reporters=default",
    "test:watch": "jest --watch",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "frontend:dev": "npm --prefix frontend-vite install && npm --prefix frontend-vite run dev",
    "frontend:build": "npm --prefix frontend-vite install && npm --prefix frontend-vite run build"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "fast-xml-parser": "^5.7.3",
    "google-auth-library": "^10.6.2",
    "prisma": "^6.19.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "jest": "^29.0.0",
    "supertest": "^6.3.4"
  }
}
